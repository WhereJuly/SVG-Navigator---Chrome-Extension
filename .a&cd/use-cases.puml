@startuml Pan & Zoom Use Cases
top to bottom direction

actor User

rectangle "SVG Pan and Zoom Extension" {
  usecase "Zoom In" as UC1
  usecase "Zoom Out" as UC2
  usecase "Pan" as UC3
  usecase "Reset Zoom" as UC4
  usecase "Enable/Disable Pan Mode" as UC5
}

' Explicitly control use case order by positioning
UC1 -[hidden]-> UC2
UC2 -[hidden]-> UC3
UC3 -[hidden]-> UC4
UC4 -[hidden]-> UC5

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5

@enduml
